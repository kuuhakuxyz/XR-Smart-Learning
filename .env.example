# Optional: Set repository base path when building manually for GitHub Pages.
# Example: VITE_BASE_PATH="/xr-smart-learning/"
# Leave unset for local dev ("/") or GitHub Actions auto-detection.
VITE_BASE_PATH="/"

# GEMINI_API_KEY: Not required for static GitHub Pages prototype mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Used in AI Studio runtime previews.
APP_URL="MY_APP_URL"
